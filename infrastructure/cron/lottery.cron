# Lottery Intelligence Platform — orchestration schedule
# Timezone: Africa/Abidjan (configure CRON_TZ below; never assume server TZ).
# Install: crontab infrastructure/cron/lottery.cron   (adjust REPO/PYTHON paths)

CRON_TZ=Africa/Abidjan
REPO=/path/to/lottery-intelligence-platform
PYTHON=$REPO/.venv/bin/python

# Collect new draw results every 5 minutes (detection only; the pipeline
# is event-driven and resumes unfinished work automatically).
*/5 * * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job collect_results >> logs/collect.log 2>&1

# Settlement pipeline: picks up FROZEN draws, locks + settles predictions.
*/5 * * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-due >> logs/worker.log 2>&1

# Daily research summary at 23:00.
0 23 * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job daily_research_summary >> logs/summary.log 2>&1

# Weekly research report, Sunday 23:30.
30 23 * * 0 cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job weekly_research_report >> logs/weekly.log 2>&1

# Backups: PostgreSQL 02:00, raw storage 02:30, verification 03:00.
0 2 * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job backup_postgresql >> logs/backup.log 2>&1
30 2 * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job backup_raw_storage >> logs/backup.log 2>&1
0 3 * * * cd $REPO && $PYTHON -m lottery_intelligence_platform.orchestrator_cli run-job verify_backups >> logs/backup.log 2>&1
