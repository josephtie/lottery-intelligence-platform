# VPS application environment — copy to infrastructure/vps/.env and fill in.
# Never commit the real .env.

# PostgreSQL (external to this compose stack — managed instance or separate container)
LOTTERY_DATABASE_HOST=
LOTTERY_DATABASE_PORT=5432
LOTTERY_DATABASE_NAME=lottery_platform
LOTTERY_DATABASE_USER=lottery_app
# libpq reads PGPASSWORD automatically — every module honors it.
PGPASSWORD=

# S3-compatible raw object store (MinIO or managed object storage)
LOTTERY_S3_ENDPOINT_URL=
LOTTERY_S3_BUCKET=lottery-raw
LOTTERY_S3_REGION=us-east-1
LOTTERY_S3_ACCESS_KEY=
LOTTERY_S3_SECRET_KEY=

# Backups land in the lottery-backups volume (mounted at /app/backups)
LOTTERY_BACKUP_DIR=/app/backups

# Read-only API — REQUIRED when bound beyond loopback
LOTTERY_API_TOKEN=
LOTTERY_API_PORT=8090
