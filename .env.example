LOTTERY_S3_ENDPOINT_URL=http://127.0.0.1:19000
LOTTERY_S3_BUCKET=lottery-raw
LOTTERY_S3_REGION=us-east-1
LOTTERY_S3_ACCESS_KEY=
LOTTERY_S3_SECRET_KEY=
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
LOTTERY_DATABASE_HOST=localhost
LOTTERY_DATABASE_PORT=5433
LOTTERY_DATABASE_NAME=lottery_platform
LOTTERY_DATABASE_USER=directus

# Dedicated integration-test database — never point this at the live DB.
# Create/refresh: createdb -T lottery_platform lottery_platform_test
# (terminate connections to the template first), then apply_migrations.
LOTTERY_TEST_DATABASE_URL=host=localhost port=5432 dbname=lottery_platform_test user=directus

# Read-only API bearer token (required when serving beyond loopback)
LOTTERY_API_TOKEN=
